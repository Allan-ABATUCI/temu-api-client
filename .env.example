# ─────────────────────────────────────────────────────────────
# Temu Open Platform — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs.
# Ne JAMAIS committer le fichier .env.
# ─────────────────────────────────────────────────────────────

# Credentials Temu (obtenus sur seller.temu.com > Espace développeur)
TEMU_APP_KEY=votre_app_key_ici
TEMU_APP_SECRET=votre_app_secret_ici
TEMU_ACCESS_TOKEN=votre_access_token_ici


# Base de données Temu (MySQL partagé)
HOST_DB=
PORT_DB=
USER_BD_STAGIAIRE=
DB_PASSWORD=
DB_TEMU=
EBAY_DB_NAME=

# Optionnel — URL de base (laisser vide en production)
# TEMU_API_BASE_URL=https://openapi.temu.com/v1

# Optionnel — Algorithme de signature : md5 (défaut) ou hmac_sha256
# TEMU_SIGNING_ALGO=md5
